# 一、应用与安全
DATABASE_URL=sqlite:///./storage/app.db
# 必填：生成独立、不可预测且至少 32 个字符的随机值。
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=120
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=true
TZ=Asia/Shanghai
APP_ENVIRONMENT=production
# 必填：生产 HTTPS 根地址，不带路径、查询参数、片段或末尾斜杠，例如 https://example.com。
APP_PUBLIC_URL=

# 二、飞书应用 B 与登录
# 必填：仅保存在生产服务器私有 .env 中。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必填：必须精确等于 APP_PUBLIC_URL 加 /login/callback，并已发布到飞书开放平台。
FEISHU_REDIRECT_URI=
FEISHU_API_BASE=https://open.feishu.cn
FEISHU_SYNC_PROFILE_ON_LOGIN=true
FEISHU_NOTIFICATION_ENABLED=true
# 必填：首次部署前填写系统 Owner 的飞书 union_id。
OWNER_FEISHU_UNION_ID=
DEFAULT_MEMBER_PERMISSIONS=

# 三、AI 大脑查宝
# 安全默认关闭。完成生产配置和正式验收后才可改为 true；故障回滚时改回 false。
FEISHU_CHAT_ENABLED=false
FEISHU_CHAT_ENVIRONMENT=production
# 必填：必须精确等于 APP_PUBLIC_URL 加 /chat/oauth/callback，并已发布到飞书开放平台。
FEISHU_CHAT_OAUTH_REDIRECT_URI=
# 必填：独立 Fernet key，不得复用 JWT_SECRET；轮换或丢失会使已有用户凭据无法解密。
FEISHU_CREDENTIAL_ENCRYPTION_KEY=

# 四、飞书 OAuth 接口
# 官方接口发生变更时才调整这些端点和权限范围。
FEISHU_AUTHORIZE_BASE=https://accounts.feishu.cn
FEISHU_AUTHORIZE_PATH=/open-apis/authen/v1/authorize
FEISHU_TOKEN_PATH=/open-apis/authen/v2/oauth/token
FEISHU_USER_INFO_PATH=/open-apis/authen/v1/user_info
FEISHU_OAUTH_SCOPE=contact:user.base:readonly

# 五、飞书通讯录与组织归属
DEPARTMENT_PRIORITY=总经办,市场运营部,产品管理部
FEISHU_TENANT_TOKEN_PATH=/open-apis/auth/v3/tenant_access_token/internal
FEISHU_CONTACT_DEPT_PATH=/open-apis/contact/v3/departments
FEISHU_CONTACT_USER_PATH=/open-apis/contact/v3/users
