DATABASE_URL=sqlite:///./storage/app.db
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=120
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
TZ=Asia/Shanghai
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/login/callback
FEISHU_API_BASE=https://open.feishu.cn
FEISHU_SYNC_PROFILE_ON_LOGIN=true
# 飞书 OAuth2（新版）端点/参数，一般用默认值即可；上线前以飞书控制台/文档为准
FEISHU_AUTHORIZE_BASE=https://accounts.feishu.cn
FEISHU_AUTHORIZE_PATH=/open-apis/authen/v1/authorize
FEISHU_TOKEN_PATH=/open-apis/authen/v2/oauth/token
FEISHU_USER_INFO_PATH=/open-apis/authen/v1/user_info
# 空格分隔的 scope，需在控制台「权限管理」申请对应权限
FEISHU_OAUTH_SCOPE=contact:user.base:readonly
# v1.3 起 Owner 必须用 union_id 指定（首登即 owner 的兜底已取消）
OWNER_FEISHU_UNION_ID=
DEFAULT_MEMBER_PERMISSIONS=
# 顶层部门优先级（逗号分隔）：一个人同时属于多个顶层部门时，按此顺序择优显示归属部门
DEPARTMENT_PRIORITY=
# 飞书通讯录同步（v1.3，应用身份 tenant_access_token；scope: tenant:tenant:readonly、contact:contact.base:readonly）
FEISHU_TENANT_TOKEN_PATH=/open-apis/auth/v3/tenant_access_token/internal
FEISHU_CONTACT_DEPT_PATH=/open-apis/contact/v3/departments
FEISHU_CONTACT_USER_PATH=/open-apis/contact/v3/users
